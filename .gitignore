# Gallery derivatives — regenerated by npm run generate-assets / npm run build (CI too).
# Track originals (public/gallery/*.{jpg,...}) and meta/*.json in git; not thumbs/ or display/.
/public/gallery/thumbs/*
!/public/gallery/thumbs/.gitkeep
/public/gallery/display/*
!/public/gallery/display/.gitkeep
